{
  "expo": {
    "extra": {
      "trustedApiHosts": ["hostelbites-backend-jwmt.onrender.com"]
    },
    "name": "ZenWe PG Partner",
    "slug": "zcs-pg-partner",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/zenwe-pg-partner-icon-2026-11-04.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/zenwe-splash-badge-2026-11-04.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0A1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.srm.zenvypgowner"
    },
    "android": {
      "package": "com.srm.zenvypgowner",
      "versionCode": 6,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FAE04B",
        "foregroundImage": "./assets/zenwe-pg-partner-adaptive-foreground-2026-11-04.png",
        "backgroundImage": "./assets/zenv-adaptive-backdrop-2026-11-04.png",
        "monochromeImage": "./assets/zenwe-pg-partner-adaptive-monochrome-2026-11-04.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "./plugins/withReleaseSigning",
        {
          "prefix": "ZENVY_PGOWNER_UPLOAD",
          "appLabel": "ZenWe PG Partner",
          "readme": "pg-owner-app/README.md"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZenWe PG Partner uses your photos to add pictures of your PG (rooms, bathrooms, mess, building).",
          "cameraPermission": "ZenWe PG Partner uses the camera to take pictures of your PG for the listing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF4F5F",
          "sounds": [
            "./assets/sounds/alert.wav"
          ],
          "defaultChannel": "delivery-alerts-v2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
    ]
  }
}
