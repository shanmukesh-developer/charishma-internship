{
  "expo": {
    "extra": {
      "trustedApiHosts": [
        "hostelbites-backend-jwmt.onrender.com"
      ]
    },
    "name": "ZenWe",
    "slug": "zenvy-customer",
    "version": "1.0.76",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/zenwe-icon-2026-11-04.png",
    "userInterfaceStyle": "light",
    "scheme": "zenvy",
    "splash": {
      "image": "./assets/zenv-splash-blank-white-2026-11-04.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.srm.hostelbites",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "ZenWe uses the camera for campus video calls and ID verification.",
        "NSMicrophoneUsageDescription": "ZenWe uses the microphone for campus voice and video calls.",
        "NSPhotoLibraryUsageDescription": "Allow ZenWe to access your photos to attach pictures to orders, lost & found posts and chats."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/zenwe-adaptive-foreground-2026-11-04.png",
        "backgroundColor": "#FAE04B",
        "backgroundImage": "./assets/zenv-adaptive-backdrop-2026-11-04.png",
        "monochromeImage": "./assets/zenwe-adaptive-monochrome-2026-11-04.png"
      },
      "package": "com.srm.hostelbites",
      "googleServicesFile": "./google-services.json",
      "versionCode": 77,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "minSdkVersion": 24,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "allowBackup": false
    },
    "web": {
      "name": "ZenWe",
      "shortName": "ZenWe",
      "favicon": "./assets/zenwe-favicon-2026-11-04.png",
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-router",
      "@react-native-firebase/crashlytics",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ZenWe to access your photos to attach pictures to orders, lost & found posts and chats.",
          "cameraPermission": "Allow ZenWe to use the camera to take photos and for campus video calls.",
          "microphonePermission": "Allow ZenWe to use the microphone for campus voice calls and Spaces."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/zenv-notification-icon-2026-11-04.png",
          "color": "#EF4F5F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
