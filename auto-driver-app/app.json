{
  "expo": {
    "extra": {
      "trustedApiHosts": ["hostelbites-backend-jwmt.onrender.com"]
    },
    "name": "ZenWe Auto Driver",
    "slug": "zenvy-auto-driver",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/zenwe-auto-icon-2026-11-04.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.srm.zenvyautodriver"
    },
    "android": {
      "package": "com.srm.zenvyautodriver",
      "versionCode": 11,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FAE04B",
        "foregroundImage": "./assets/zenwe-auto-adaptive-foreground-2026-11-04.png",
        "backgroundImage": "./assets/zenv-adaptive-backdrop-2026-11-04.png",
        "monochromeImage": "./assets/zenwe-auto-adaptive-monochrome-2026-11-04.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "./plugins/withReleaseSigning",
        {
          "prefix": "ZENVY_DRIVER_UPLOAD",
          "legacyPrefix": "ZENVY_UPLOAD",
          "readme": "auto-driver-app/README.md"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZenWe Auto Driver uses your photos to upload your licence, vehicle papers and auto photos for verification.",
          "cameraPermission": "ZenWe Auto Driver uses the camera to photograph your licence, vehicle papers and auto for verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF4F5F",
          "sounds": [
            "./assets/sounds/alert.wav"
          ],
          "defaultChannel": "delivery-alerts-v2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
    ]
  }
}
