{
  "expo": {
    "extra": {
      "trustedApiHosts": ["hostelbites-backend-jwmt.onrender.com"]
    },
    "name": "ZENV Vendor",
    "slug": "zenvy-vendor",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/zenv-vendor-icon-2026-11-04.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.srm.zenvyvendor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAE04B",
        "foregroundImage": "./assets/zenv-vendor-adaptive-foreground-2026-11-04.png",
        "backgroundImage": "./assets/zenv-adaptive-backdrop-2026-11-04.png",
        "monochromeImage": "./assets/zenv-vendor-adaptive-monochrome-2026-11-04.png"
      },
      "package": "com.srm.zenvyvendor",
      "versionCode": 9,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withKitchenService",
      [
        "./plugins/withReleaseSigning",
        {
          "prefix": "ZENVY_VENDOR_UPLOAD",
          "readme": "vendor-app/README.md"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZENV Vendor uses your photos to add pictures of your items.",
          "cameraPermission": "ZENV Vendor uses the camera to take pictures of your items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF4F5F",
          "sounds": [
            "./assets/sounds/alert.wav"
          ],
          "defaultChannel": "delivery-alerts-v2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ]
    ]
  }
}
