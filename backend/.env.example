PORT=8080
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*

# Database (PostgreSQL for production, SQLite used in local dev if omitted)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# MONGO_URI=mongodb+srv://...

# Firebase Admin SDK (for push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Process role (jobs/index.js, utils/processRole.js)
# all (default) = API + sockets + scheduled jobs | web = API + sockets only | worker = jobs + health only
# (worker has no socket server: job socket emits are dropped with a warning until the Redis emitter, Phase 2)
# PROCESS_ROLE=all
# KEEPALIVE=false        # turn off the production self-ping (only useful on Render free)
# JOBS_DEBUG=1           # print skipped job ticks and idle runs (debug level)

# Future-ready infra (docs/INFRA_SWITCHOVER.md). All unset = today's behaviour.
# PUBLIC_API_URL=https://api.example.com      # absolute links + address advertised to the apps
# PUBLIC_SOCKET_URL=                          # default PUBLIC_API_URL
# PUBLIC_WEB_URL=https://admin.example.com    # advertised + allowed CORS origin
# ALLOWED_ORIGINS=https://a.example.com,https://b.example.com
# TRUST_PROXY=1
# TRUST_CLOUDFLARE=1                          # only behind Cloudflare (orange cloud)
# EDGE_CACHE=1                                # CDN-friendly Cache-Control (+ EDGE_CACHE_GROUPS / _SMAXAGE / _SWR)
# DB_SSL=auto                                 # auto | disable | require | verify (+ DB_SSL_CA)
# MEDIA_STORAGE=db                            # db | s3 (Cloudflare R2)
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# R2_PUBLIC_BUCKET= R2_PUBLIC_URL=            # optional separate public bucket + its public URL
# MEDIA_PRIVATE_DELIVERY=proxy                # proxy | redirect (MEDIA_PRESIGN_TTL_S, default 300)
